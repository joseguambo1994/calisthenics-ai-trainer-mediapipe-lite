        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const msg = item.json.message;\n\n  const chatId = msg?.chat?.id;\n  const fileIdRaw = msg?.video?.file_id || msg?.document?.file_id;\n  const fileId = typeof fileIdRaw === 'string' ? fileIdRaw.trim() : '';\n\n  if (!fileId) {\n    out.push({ json: { chat_id: chatId, error: 'No video found in message.' } });\n    continue;\n  }\n\n  out.push({\n    json: {\n      chat_id: chatId,\n      file_id: fileId\n    }\n  });\n}\n\nreturn out;"
